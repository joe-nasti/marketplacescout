{
  "name": "collectish-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "mcp:chrome": "npx chrome-devtools-mcp@latest",
    "check:styles": "node tools/check-style-system.mjs",
    "check:hygiene": "node tools/check-source-hygiene.mjs",
    "check:navigation": "node tools/check-navigation-contract.mjs",
    "test:browser": "playwright test --config tools/playwright.config.mjs",
    "test:browser:install": "playwright install chromium",
    "build": "npm run check:hygiene && npm run check:styles && npm run check:navigation && vite build && node tools/finalize-vite-build.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "vite": "8.0.0"
  }
}

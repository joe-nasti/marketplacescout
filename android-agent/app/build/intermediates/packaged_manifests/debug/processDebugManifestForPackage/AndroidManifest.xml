<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.collectish.agent"
    android:versionCode="35"
    android:versionName="0.2.15" >

    <uses-sdk
        android:minSdkVersion="28"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/collectish_launcher"
        android:label="Collectish"
        android:roundIcon="@drawable/collectish_launcher"
        android:theme="@style/AppTheme" >
        <activity
            android:name="com.collectish.agent.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.collectish.agent.SellerSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>